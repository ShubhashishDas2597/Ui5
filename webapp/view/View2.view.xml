<?xml version="1.0" encoding="UTF-8" ?>
<mvc:View
    controllerName="product.controller.View2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        showNavButton="true"
        navButtonPress="onNavBack"
    >
        <content>
            <Table
                growing="true"
                growingThreshold="20"
                items="{
                path: 'Prod>/ProductCollection' 
            }"
            >
                <columns>
                    <Column>
                        <Text text='Product ID' />
                    </Column>
                    <Column>
                        <Text text='Category' />
                    </Column>
                    <Column>
                        <Text text='Name' />
                    </Column>
                    <Column>
                        <Text text='Description' />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Bottom">
                        <cells>
                            <Text text="{Prod>ProductId}" />
                            <Text text="{Prod>Category}" />
                            <Text text="{Prod>Name}" />
                            <Text text="{Prod>Description}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
